# Upstash Redis Configuration
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxxxx=

# Upstash QStash Configuration
QSTASH_URL=https://qstash-eu-central-1.upstash.io
QSTASH_TOKEN=ey...
QSTASH_CURRENT_SIGNING_KEY=sig_...
QSTASH_NEXT_SIGNING_KEY=sig_...

# Base URL of the deployment (used by QStash to invoke /api/job/:id/tick)
# In production on Vercel: https://your-app.vercel.app
# In local development with tunnel: https://xxxx.ngrok-free.app
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Shared Secret to gate UI and API routes
# Set this to a secure random string (e.g. openssl rand -hex 24)
TOOL_SHARED_SECRET=your-shared-secret-here
